import os

builder.SetBuildFolder("package")

name = MMSPlugin.metadata["name"]
bin_path = os.path.join("addons", name, "bin")
metamod_path = os.path.join("addons", "metamod")
builder.AddFolder(bin_path)
builder.AddFolder(metamod_path)

vdf = '"Metamod Plugin"\n{\n'
vdf += '\t"alias"\t"{}"\n'.format(MMSPlugin.metadata["alias"])
vdf += '\t"file"\t"addons/{0}/bin/{0}"\n'.format(name)
vdf += "}\n"
builder.AddOutputFile(os.path.join(metamod_path, name + ".vdf"), vdf.encode("utf8"))

for task in MMSPlugin.tasks:
    builder.AddCopy(task.binary, os.path.join(bin_path, name + ".so"))
